{
  "name": "@mage-med/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
    "lint": "eslint src vite.config.ts vitest.config.ts vitest.smoke.config.ts",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@mage-med/contracts": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
