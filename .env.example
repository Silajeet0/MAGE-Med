# Runtime identity and logging
MAGE_MED_ENVIRONMENT=development
MAGE_MED_LOG_LEVEL=INFO
MAGE_MED_CORS_ORIGINS=["http://localhost:5173"]

# Local operational database. SQLite is the source of operational truth.
MAGE_MED_DATABASE_URL=sqlite:///./var/mage_med.db

# Maximum accepted local FHIR JSON upload size (10 MiB default).
MAGE_MED_FHIR_MAX_UPLOAD_BYTES=10485760
MAGE_MED_CLINICAL_TEXT_IMPORT_ROOT=
MAGE_MED_CLINICAL_TEXT_MAX_UPLOAD_BYTES=2097152
MAGE_MED_CLINICAL_TEXT_MAX_NOTE_BYTES=262144
MAGE_MED_CLINICAL_TEXT_MAX_NOTES=1000
MAGE_MED_CLINICAL_TEXT_CHUNK_CHARACTERS=1000
MAGE_MED_CLINICAL_TEXT_CHUNK_OVERLAP=100

# Neo4j Community service from infrastructure/compose.yaml.
# This password is only a local development example; replace it outside local demos.
MAGE_MED_NEO4J_URI=bolt://localhost:7687
MAGE_MED_NEO4J_USERNAME=neo4j
MAGE_MED_NEO4J_PASSWORD=mage-med-local
MAGE_MED_NEO4J_DATABASE=neo4j
MAGE_MED_NEO4J_TIMEOUT_SECONDS=3.0
MAGE_MED_NEO4J_BROWSER_PORT=7474
MAGE_MED_NEO4J_BOLT_PORT=7687

# Development server bindings used by the Makefile.
MAGE_MED_BACKEND_HOST=127.0.0.1
MAGE_MED_BACKEND_PORT=8000
MAGE_MED_FRONTEND_HOST=127.0.0.1
MAGE_MED_FRONTEND_PORT=5173

# Frontend build/runtime development setting.
VITE_API_BASE_URL=http://localhost:8000

# Optional future integrations. They do not block this milestone's app startup.
MAGE_MED_OLLAMA_BASE_URL=http://localhost:11434
MAGE_MED_MLFLOW_TRACKING_URI=http://localhost:5000
