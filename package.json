{
  "name": "mage-med-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/frontend",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
